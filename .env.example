# =============================================================================
# Copilot Studio Testing - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to source control!
# =============================================================================

# -----------------------------------------------------------------------------
# Azure AD Authentication (Required)
# -----------------------------------------------------------------------------
APP_CLIENT_ID=your-app-client-id
TENANT_ID=your-tenant-id

# For CI/CD (service principal authentication)
# APP_CLIENT_SECRET=your-client-secret

# -----------------------------------------------------------------------------
# Copilot Studio Agent (Required)
# -----------------------------------------------------------------------------
ENVIRONMENT_ID=your-environment-id
AGENT_IDENTIFIER=your-agent-identifier

# -----------------------------------------------------------------------------
# LLM for Evaluation (Required - choose one)
# -----------------------------------------------------------------------------

# Option 1: OpenAI
OPENAI_API_KEY=your-openai-api-key

# Option 2: Azure OpenAI (uncomment and fill in)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# -----------------------------------------------------------------------------
# Enterprise Features (Optional)
# -----------------------------------------------------------------------------

# Environment (dev, staging, prod)
# ENVIRONMENT=dev

# Azure Key Vault (load secrets from Key Vault instead of .env)
# KEY_VAULT_NAME=your-keyvault-name

# Notifications
# TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Result Storage
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
